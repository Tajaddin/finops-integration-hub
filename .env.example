# Copy with `make env` (writes .env, git-ignored): every value marked generate-me is replaced by a random local
# secret. Nothing in this file is a secret. Real-account credentials (Salesforce, Jira, GitHub) never go in a
# committed file; see docs/DEPLOY.md.

# --- shared Postgres (one database and login per system) ---
POSTGRES_PASSWORD=generate-me
ODOO_DB_PASSWORD=generate-me
HUB_DB_PASSWORD=generate-me
N8N_DB_PASSWORD=generate-me
ZAMMAD_DB_PASSWORD=generate-me
LANGFUSE_DB_PASSWORD=generate-me

# --- Odoo (ERP) ---
ODOO_ADMIN_PASSWORD=generate-me
HUB_ODOO_URL=http://127.0.0.1:8069
HUB_ODOO_DATABASE=odoo
# the API key is written by `make bootstrap` to .secrets/odoo_api_key
HUB_ODOO_API_KEY_FILE=.secrets/odoo_api_key

# --- EspoCRM (CRM) ---
ESPOCRM_DB_PASSWORD=generate-me
ESPOCRM_ADMIN_PASSWORD=generate-me
HUB_ESPOCRM_URL=http://127.0.0.1:8080
HUB_ESPOCRM_API_KEY_FILE=.secrets/espocrm_api_key
HUB_ESPOCRM_WEBHOOK_SECRET_FILE=.secrets/espocrm_webhook_secret

# --- Zammad (tickets) ---
ZAMMAD_ADMIN_PASSWORD=generate-me
HUB_ZAMMAD_URL=http://127.0.0.1:8081
HUB_ZAMMAD_TOKEN_FILE=.secrets/zammad_token

# --- hub ---
HUB_DATABASE_URL=postgresql://hub:${HUB_DB_PASSWORD}@127.0.0.1:55432/hub
# the key n8n and the CLI send as X-API-Key; the hub keeps only its SHA-256 digest in memory
HUB_API_KEY=generate-me
HUB_LOG_LEVEL=INFO
HUB_CRM=espocrm
HUB_TICKETS=zammad

# --- n8n ---
N8N_ENCRYPTION_KEY=generate-me
N8N_OWNER_PASSWORD=generate-me

# --- local LLM (Ollama on the host) ---
HUB_OLLAMA_URL=http://127.0.0.1:11434
HUB_TRIAGE_MODEL=qwen2.5:7b
HUB_EMBED_MODEL=nomic-embed-text

# --- Langfuse (self-hosted) ---
LANGFUSE_SALT=generate-me
LANGFUSE_ENCRYPTION_KEY=generate-me-64
LANGFUSE_NEXTAUTH_SECRET=generate-me
LANGFUSE_CLICKHOUSE_PASSWORD=generate-me
LANGFUSE_REDIS_PASSWORD=generate-me
LANGFUSE_MINIO_PASSWORD=generate-me
LANGFUSE_ADMIN_PASSWORD=generate-me
LANGFUSE_PUBLIC_KEY=pk-lf-generate-me
LANGFUSE_SECRET_KEY=sk-lf-generate-me
HUB_LANGFUSE_URL=http://127.0.0.1:3000

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=generate-me

# --- real accounts (unset = not used); see docs/DEPLOY.md ---
# HUB_SALESFORCE_INSTANCE_URL=https://<your-domain>.my.salesforce.com
# HUB_SALESFORCE_CLIENT_ID=
# HUB_SALESFORCE_CLIENT_SECRET_FILE=/path/outside/the/repo/salesforce_client_secret
# HUB_JIRA_URL=https://<your-site>.atlassian.net
# HUB_JIRA_EMAIL=
# HUB_JIRA_TOKEN_FILE=/path/outside/the/repo/jira_token
# HUB_GITHUB_REPO=<owner>/<repo>
